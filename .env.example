# ---------------------------------------------------------------
# BingLinkFinder configuration
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------

# --- database -------------------------------------------------
DATABASE_URL=postgresql+psycopg://blf:blf_change_me@db:5432/blf
POSTGRES_USER=blf
POSTGRES_PASSWORD=blf_change_me
POSTGRES_DB=blf
# Local dev: DATABASE_URL=sqlite:///./data/blf.db

# --- search backend -------------------------------------------
SEARCH_PROVIDER=searxng
# Self-hosted SearXNG. This project targets Bing discovery by default.
SEARXNG_URL=http://searxng:8080
SEARXNG_ENGINES=bing
SEARXNG_LANGUAGE=en
SEARXNG_SAFESEARCH=0
# Optional alternative providers
SERPER_API_KEY=
BRAVE_API_KEY=

# --- github collector -----------------------------------------
# Optional but strongly recommended: GitHub API limit 60/h -> 5000/h
GITHUB_TOKEN=

# --- crawler behaviour ----------------------------------------
USER_AGENT=BingLinkFinder/1.0
REQUEST_TIMEOUT=20
CHECKER_CONCURRENCY=16
CHECKER_BATCH_SIZE=500
PER_DOMAIN_DELAY=2.0
RESPECT_ROBOTS_TXT=true

# --- scheduler -------------------------------------------------
JOB_GITHUB_SEEDS_HOURS=24
JOB_FOOTPRINT_HOURS=6
JOB_CLASSIFY_MINUTES=30
JOB_CHECKER_HOURS=1
JOB_RECHECK_DAYS=14
JOB_REPORT_HOUR=9

# --- domain authority metrics ---------------------------------
# Optional enrichment only; discovery must work without metrics.
METRICS_PROVIDER=openpagerank
OPENPAGERANK_API_KEY=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
METRICS_REFRESH_DAYS=90
METRICS_BATCH_DOMAINS=500
MIN_PAGE_RANK=0

# --- backlink tracker -----------------------------------------
JOB_TRACKER_HOURS=12
TRACKER_BATCH_SIZE=200
TRACKER_RECHECK_DAYS=7

# --- outreach --------------------------------------------------
OUTREACH_ENABLED=false
OUTREACH_REQUIRE_APPROVAL=true
OUTREACH_DAILY_LIMIT=25
OUTREACH_FOLLOW_UP_DAYS=5
OUTREACH_MAX_FOLLOW_UPS=2
OUTREACH_MIN_PAGE_RANK=0
OUTREACH_FROM_NAME=
OUTREACH_FROM_EMAIL=
OUTREACH_REPLY_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true

# --- telegram --------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- api -------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
DASHBOARD_KEY=
