# ---------------------------------------------------------------
# BingLinkFinder configuration
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------

# --- database -------------------------------------------------
# Postgres (production / docker compose)
DATABASE_URL=postgresql+psycopg://blf:blf_change_me@db:5432/blf
POSTGRES_USER=blf
POSTGRES_PASSWORD=blf_change_me
POSTGRES_DB=blf

# Local dev without Postgres:
# DATABASE_URL=sqlite:///./data/blf.db

# --- search backend -------------------------------------------
# Which provider the footprint hunter uses: searxng | serper | brave | none
SEARCH_PROVIDER=searxng

# self-hosted SearXNG (shipped in docker-compose, free, no API key)
SEARXNG_URL=http://searxng:8080

# serper.dev (paid Google API) - only if SEARCH_PROVIDER=serper
SERPER_API_KEY=

# Brave Search API - only if SEARCH_PROVIDER=brave
BRAVE_API_KEY=

# --- github collector -----------------------------------------
# Optional but strongly recommended: raises rate limit 60/h -> 5000/h
GITHUB_TOKEN=

# --- crawler behaviour ----------------------------------------
USER_AGENT=BingLinkFinder/1.0 (+https://github.com/yourname/bing-link-finder)
REQUEST_TIMEOUT=20
CHECKER_CONCURRENCY=16
CHECKER_BATCH_SIZE=500
# polite delay between requests to the SAME domain, seconds
PER_DOMAIN_DELAY=2.0
RESPECT_ROBOTS_TXT=true

# --- scheduler (cron-ish, hours) -------------------------------
JOB_GITHUB_SEEDS_HOURS=24
JOB_FOOTPRINT_HOURS=6
JOB_CLASSIFY_MINUTES=30
JOB_CHECKER_HOURS=1
JOB_RECHECK_DAYS=14
JOB_REPORT_HOUR=9

# --- telegram --------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- api -------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
# Set a value to require ?key=... (or X-API-Key header) on the dashboard
DASHBOARD_KEY=
