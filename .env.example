# ---------------------------------------------------------------
# BingLinkFinder configuration
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------

# --- database -------------------------------------------------
# Postgres (production / docker compose)
DATABASE_URL=postgresql+psycopg://blf:blf_change_me@db:5432/blf
POSTGRES_USER=blf
POSTGRES_PASSWORD=blf_change_me
POSTGRES_DB=blf

# Local dev without Postgres:
# DATABASE_URL=sqlite:///./data/blf.db

# --- search backend -------------------------------------------
# Which provider the footprint hunter uses: searxng | serper | brave | none
SEARCH_PROVIDER=searxng

# self-hosted SearXNG (shipped in docker-compose, free, no API key)
SEARXNG_URL=http://searxng:8080

# serper.dev (paid Google API) - only if SEARCH_PROVIDER=serper
SERPER_API_KEY=

# Brave Search API - only if SEARCH_PROVIDER=brave
BRAVE_API_KEY=

# --- github collector -----------------------------------------
# Optional but strongly recommended: raises rate limit 60/h -> 5000/h
GITHUB_TOKEN=

# --- crawler behaviour ----------------------------------------
USER_AGENT=BingLinkFinder/1.0 (+https://github.com/yourname/bing-link-finder)
REQUEST_TIMEOUT=20
CHECKER_CONCURRENCY=16
CHECKER_BATCH_SIZE=500
# polite delay between requests to the SAME domain, seconds
PER_DOMAIN_DELAY=2.0
RESPECT_ROBOTS_TXT=true

# --- scheduler (cron-ish, hours) -------------------------------
JOB_GITHUB_SEEDS_HOURS=24
JOB_FOOTPRINT_HOURS=6
JOB_CLASSIFY_MINUTES=30
JOB_CHECKER_HOURS=1
JOB_RECHECK_DAYS=14
JOB_REPORT_HOUR=9

# --- domain authority metrics ---------------------------------
# openpagerank (free, register at domcop.com/openpagerank) | dataforseo | none
METRICS_PROVIDER=openpagerank
OPENPAGERANK_API_KEY=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
METRICS_REFRESH_DAYS=90
METRICS_BATCH_DOMAINS=500
# exports drop anything below this authority (0 = keep everything).
# Leave at 0 until metrics have actually been fetched.
MIN_PAGE_RANK=0

# --- backlink tracker (links you placed) -----------------------
JOB_TRACKER_HOURS=12
TRACKER_BATCH_SIZE=200
TRACKER_RECHECK_DAYS=7

# --- outreach ---------------------------------------------------
# Master switch. While false, drafts are written but NOTHING is sent.
OUTREACH_ENABLED=false
# Every draft waits for `blf outreach approve` before it can go out.
OUTREACH_REQUIRE_APPROVAL=true
OUTREACH_DAILY_LIMIT=25
OUTREACH_FOLLOW_UP_DAYS=5
OUTREACH_MAX_FOLLOW_UPS=2
# Authority floor for prospecting. 0 = take the best-scoring sites
# regardless of authority; ignored anyway until metrics exist.
OUTREACH_MIN_PAGE_RANK=0
OUTREACH_FROM_NAME=
OUTREACH_FROM_EMAIL=
OUTREACH_REPLY_TO=

# Without SMTP settings the mailer runs in dry-run mode: it logs what it
# would have sent and marks the draft, but nothing leaves the machine.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true

# --- telegram --------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- api -------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
# Set a value to require ?key=... (or X-API-Key header) on the dashboard
DASHBOARD_KEY=
